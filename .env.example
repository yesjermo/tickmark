# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.
SWINGDESK_MASTER_KEY=replace-with-a-long-random-string
SWINGDESK_SETUP_CODE=replace-with-another-random-string
SWINGDESK_PUBLIC_URL=
SWINGDESK_SECURE_COOKIES=off
SWINGDESK_GOOGLE_CLIENT_ID=
SWINGDESK_GOOGLE_CLIENT_SECRET=
SWINGDESK_GITHUB_CLIENT_ID=
SWINGDESK_GITHUB_CLIENT_SECRET=
